# Admin CMS (/admin)
# Default password if unset: promptstack-admin
ADMIN_PASSWORD=promptstack-admin
ADMIN_SECRET=change-me-to-a-long-random-string

# Visitor analytics (required on Vercel / read-only hosts)
# Free Redis: https://console.upstash.com → Create database → REST API
# Also accepts Vercel KV vars: KV_REST_API_URL + KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zoho Mail SMTP (hello@promptstacktechnologies.com)
# Zoho Mail → Security → App Passwords → create one for “Promptstack Website”
# Host: smtp.zoho.com (or smtp.zoho.eu / smtppro.zoho.com depending on your Zoho region)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hello@promptstacktechnologies.com
SMTP_PASS=
MAIL_FROM="Promptstack Technologies <hello@promptstacktechnologies.com>"
MAIL_NOTIFY_TO=hello@promptstacktechnologies.com

# Zoom discovery-call booking (Server-to-Server OAuth app)
# Marketplace → Develop → Build App → Server-to-Server OAuth
# Scopes: meeting:write:admin, meeting:read:admin, user:read:admin (or equivalent meeting scopes)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=you@yourdomain.com
BOOKING_NOTIFY_EMAIL=hello@promptstacktechnologies.com
