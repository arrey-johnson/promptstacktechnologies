# Promptstack Technologies — environment template
# Copy to .env.local for local development. Never commit secrets.

# -----------------------------------------------------------------------------
# Public
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment for indexing policy (optional override).
# Precedence: SITE_ENV > VERCEL_ENV > NODE_ENV fallback.
# Values: development | preview | staging | production
# SITE_ENV=

# -----------------------------------------------------------------------------
# Epic 6 / 6A — Start a Project (transactional)
# -----------------------------------------------------------------------------

# Supabase / PostgreSQL (server-only inserts via service role)
# Production: REQUIRED for live lead persistence.
# Development: if unset, leads persist to local .data/business-leads.json
SUPABASE_URL=
# Alternative public URL (server may also read this):
# NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile
# Production: site key + secret + allowed hostnames are REQUIRED (fail closed).
# Development without secret: documented bypass token may be used.
# Prefer Cloudflare official test keys when validating Siteverify locally:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames validated in production Siteverify responses.
# Example: www.promptstacktechnologies.com,promptstacktechnologies.com
TURNSTILE_ALLOWED_HOSTNAMES=

# Transactional email (Resend)
# Production launch checklist: configure all three.
# Development: notification is skipped (logged) when unset; lead still succeeds.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Alias also supported: RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
# Alias also supported: BUSINESS_LEAD_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
# Epic 8 — Academy applications (transactional, separate from business leads)
# -----------------------------------------------------------------------------

# Explicit admissions enablement. Default (unset/false) keeps Apply CTAs hidden
# and shows a polished unavailable state on /academy/apply.
# Values: true | false
ACADEMY_APPLICATIONS_ENABLED=false

# Separate admissions owner inbox — do NOT reuse LEAD_NOTIFICATION_EMAIL
# unless the same person is intentionally the owner.
ACADEMY_APPLICATION_NOTIFICATION_EMAIL=
# Alias also supported: ACADEMY_ADMISSIONS_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
# Epic 9 — Sanity CMS (editorial only — never transactional leads/applications)
# -----------------------------------------------------------------------------

# Public identifiers (safe in the browser)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Server-only read token (Viewer) — drafts / Presentation / sanityFetch
# SANITY_API_READ_TOKEN=

# Server-only write token — migration scripts only; never expose to browser
# SANITY_API_WRITE_TOKEN=

# Draft Mode / Presentation secret
# SANITY_PREVIEW_SECRET=
# Alias also supported: DRAFT_MODE_SECRET=

# REQUIRED for production public publication refresh (Epic 9A).
# Sanity project configured ≠ publication webhook configured.
# Used only by POST /api/revalidate via next-sanity parseBody HMAC validation.
# Never prefix with NEXT_PUBLIC_.
# SANITY_REVALIDATE_SECRET=

# Academy editorial source: local (default) | sanity
# Do NOT use this to open admissions. Admissions remain ACADEMY_APPLICATIONS_ENABLED.
# ACADEMY_CONTENT_SOURCE=local

# Epic 10 — Insights development visual fixtures ONLY.
# Requires non-production. Never creates Sanity documents. Never enters sitemap.
# Values: true | false (default unset/false)
# INSIGHTS_DEV_FIXTURES=false

# -----------------------------------------------------------------------------
# Epic 12 — Analytics (optional until IDs supplied)
# -----------------------------------------------------------------------------
# Google Tag Manager container. Absent → analytics fully disabled (no scripts).
# NEXT_PUBLIC_GTM_ID=

# Optional GA4 measurement ID for operator documentation / GTM setup notes.
# Do NOT dual-load gtag alongside GTM in application code.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console HTML tag verification token (meta).
# DNS verification may be used instead without this variable.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=

# Canonical production URL MUST be https www:
# NEXT_PUBLIC_SITE_URL=https://www.promptstacktechnologies.com
