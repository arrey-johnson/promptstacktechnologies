# Admin CMS (/admin)
# Default password if unset: promptstack-admin
ADMIN_PASSWORD=promptstack-admin
ADMIN_SECRET=change-me-to-a-long-random-string

# Zoom discovery-call booking (Server-to-Server OAuth app)
# Marketplace → Develop → Build App → Server-to-Server OAuth
# Scopes: meeting:write:admin, meeting:read:admin, user:read:admin (or equivalent meeting scopes)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=you@yourdomain.com
BOOKING_NOTIFY_EMAIL=hello@promptstacktechnologies.com
